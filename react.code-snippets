	"React - Error boundary": {
		"scope": "javascript,javascriptreact,typescript,typescriptreact",
		"prefix": "react:errorBoundary",
		"body": [
			"import React, { Component } from 'react';",
			"",
			"class ${1:ErrorBoundary} extends Component {",
			"\tconstructor(props) {",
			"\t\tsuper(props);",
			"\t\tthis.state = { hasError: false };",
			"\t}",
			"",
			"\tstatic getDerivedStateFromError() {",
			"\t\treturn { hasError: true };",
			"\t}",
			"",
			"\tcomponentDidCatch(error, info) {",
			"\t\tconsole.error(error, info.componentStack);",
			"\t}",
			"",
			"\trender() {",
			"\t\tconst { children, fallback = <p>Une erreur est survenue.</p> } = this.props;",
			"\t\treturn this.state.hasError ? fallback : children;",
			"\t}",
			"}",
			"",
			"export default ${1:ErrorBoundary};"
		],
		"description": "React - Error boundary (still needs a class component)"
	},

	// ======== HOOKS & STATE ========
	"React - Fetch hook": {
		"scope": "javascript,javascriptreact,typescript,typescriptreact",
		"prefix": "react:hookFetch",
		"body": [
			"import { useState, useEffect } from 'react';",
			"",
			"export default function use${1:Data}(url) {",
			"\tconst [data, setData] = useState(null);",
			"\tconst [loading, setLoading] = useState(true);",
			"\tconst [error, setError] = useState(null);",
			"",
			"\tuseEffect(() => {",
			"\t\tconst controller = new AbortController();",
			"\t\tsetLoading(true);",
			"\t\tsetError(null);",
			"",
			"\t\tfetch(url, { signal: controller.signal })",
			"\t\t\t.then((response) => {",
			"\t\t\t\tif (!response.ok) {",
			"\t\t\t\t\tthrow new Error(`HTTP \\${response.status}`);",
			"\t\t\t\t}",
			"\t\t\t\treturn response.json();",
			"\t\t\t})",
			"\t\t\t.then((json) => {",
			"\t\t\t\tsetData(json);",
			"\t\t\t\tsetLoading(false);",
			"\t\t\t})",
			"\t\t\t.catch((e) => {",
			"\t\t\t\tif (e.name !== 'AbortError') {",
			"\t\t\t\t\tsetError(e);",
			"\t\t\t\t\tsetLoading(false);",
			"\t\t\t\t}",
			"\t\t\t});",
			"",
			"\t\treturn () => controller.abort();",
			"\t}, [url]);",
			"",
			"\treturn { data, loading, error };",
			"}"
		],
		"description": "React - Custom hook: fetch JSON with loading/error, abort on unmount"
	},

	"React - Debounce hook": {
		"scope": "javascript,javascriptreact,typescript,typescriptreact",
		"prefix": "react:hookDebounce",
		"body": [
			"import { useState, useEffect } from 'react';",
			"",
			"export default function useDebounce(value, delay = ${1:300}) {",
			"\tconst [debounced, setDebounced] = useState(value);",
			"",
			"\tuseEffect(() => {",
			"\t\tconst timer = setTimeout(() => setDebounced(value), delay);",
			"\t\treturn () => clearTimeout(timer);",
			"\t}, [value, delay]);",
			"",
			"\treturn debounced;",
			"}"
		],
		"description": "React - Custom hook: debounce a value (search inputs)"
	},

	"React - Context": {
		"scope": "javascript,javascriptreact,typescript,typescriptreact",
		"prefix": "react:context",
		"body": [
			"import React, { createContext, useContext, useMemo, useState } from 'react';",
			"",
			"const ${1:Name}Context = createContext(null);",
			"",
			"export function ${1:Name}Provider({ children }) {",
			"\tconst [state, setState] = useState(${2:null});",
			"",
			"\tconst value = useMemo(() => ({ state, setState }), [state]);",
			"",
			"\treturn (",
			"\t\t<${1:Name}Context.Provider value={value}>",
			"\t\t\t{children}",
			"\t\t</${1:Name}Context.Provider>",
			"\t);",
			"}",
			"",
			"export function use${1:Name}() {",
			"\tconst context = useContext(${1:Name}Context);",
			"\tif (context === null) {",
			"\t\tthrow new Error('use${1:Name} must be used within a ${1:Name}Provider');",
			"\t}",
			"\treturn context;",
			"}"
		],
		"description": "React - Context + Provider + guarded hook"
	},

