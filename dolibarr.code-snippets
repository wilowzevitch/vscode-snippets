{
	// ======== PAGES & STRUCTURE ========
	"Dolibarr - Page": {
		"scope": "php",
		"prefix": "dol:page",
		"body": [
			"<?php",
			"/**",
			" * \\file    ${1:module}/${2:page}.php",
			" * \\ingroup ${1:module}",
			" * \\brief   ${3:Page description}",
			" */",
			"",
			"// Load Dolibarr environment (custom / not custom)",
			"\\$res = 0;",
			"if (!\\$res && file_exists(__DIR__.'/../main.inc.php')) {",
			"\t\\$res = @include __DIR__.'/../main.inc.php';",
			"}",
			"if (!\\$res && file_exists(__DIR__.'/../../main.inc.php')) {",
			"\t\\$res = @include __DIR__.'/../../main.inc.php';",
			"}",
			"if (!\\$res) {",
			"\tdie('Include of main fails');",
			"}",
			"",
			"require_once DOL_DOCUMENT_ROOT.'/core/class/html.form.class.php';",
			"",
			"// Translations",
			"\\$langs->loadLangs(array('${1:module}@${1:module}'));",
			"",
			"// Parameters",
			"\\$action = GETPOST('action', 'aZ09');",
			"\\$id = GETPOSTINT('id');",
			"",
			"// Access control",
			"if (!\\$user->hasRight('${1:module}', '${4:object}', 'read')) {",
			"\taccessforbidden();",
			"}",
			"",
			"",
			"/*",
			" * Actions",
			" */",
			"",
			"// None",
			"",
			"",
			"/*",
			" * View",
			" */",
			"",
			"\\$form = new Form(\\$db);",
			"",
			"llxHeader('', \\$langs->trans('${5:PageTitle}'));",
			"",
			"print load_fiche_titre(\\$langs->trans('${5:PageTitle}'), '', 'generic');",
			"",
			"$0",
			"",
			"llxFooter();",
			"\\$db->close();"
		],
		"description": "Dolibarr - Standard module page (skeleton)"
	},

	"Dolibarr - Module setup page": {
		"scope": "php",
		"prefix": "dol:module_setup_page",
		"body": [
			"<?php",
			"/* Copyright (C) ${CURRENT_YEAR} Support ${2:ModuleName} <david@freshcore.fr>",
			" *",
			" * This program is free software: you can redistribute it and/or modify",
			" * it under the terms of the GNU General Public License as published by",
			" * the Free Software Foundation, either version 3 of the License, or",
			" * (at your option) any later version.",
			" *",
			" * This program is distributed in the hope that it will be useful,",
			" * but WITHOUT ANY WARRANTY; without even the implied warranty of",
			" * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the",
			" * GNU General Public License for more details.",
			" *",
			" * You should have received a copy of the GNU General Public License",
			" * along with this program.  If not, see <https://www.gnu.org/licenses/>.",
			" */",
			"",
			"/**",
			" * \\file    ${1:module_name}/admin/${3:page_name}.php",
			" * \\ingroup ${1:module_name}",
			" * \\brief   ${4:page_title} page of module ${2:ModuleName}.",
			" */",
			"",
			"// Load Dolibarr environment",
			"\\$res = 0;",
			"// Try main.inc.php into web root known defined into CONTEXT_DOCUMENT_ROOT (not always defined)",
			"if (!\\$res && !empty(\\$_SERVER[\"CONTEXT_DOCUMENT_ROOT\"])) {",
			"\t\\$res = @include \\$_SERVER[\"CONTEXT_DOCUMENT_ROOT\"].\"/main.inc.php\";",
			"}",
			"// Try main.inc.php into web root detected using web root calculated from SCRIPT_FILENAME",
			"\\$tmp = empty(\\$_SERVER['SCRIPT_FILENAME']) ? '' : \\$_SERVER['SCRIPT_FILENAME']; \\$tmp2 = realpath(__FILE__); \\$i = strlen(\\$tmp) - 1; \\$j = strlen(\\$tmp2) - 1;",
			"while (\\$i > 0 && \\$j > 0 && isset(\\$tmp[\\$i]) && isset(\\$tmp2[\\$j]) && \\$tmp[\\$i] == \\$tmp2[\\$j]) {",
			"\t\\$i--; \\$j--;",
			"}",
			"if (!\\$res && \\$i > 0 && file_exists(substr(\\$tmp, 0, (\\$i + 1)).\"/main.inc.php\")) {",
			"\t\\$res = @include substr(\\$tmp, 0, (\\$i + 1)).\"/main.inc.php\";",
			"}",
			"if (!\\$res && \\$i > 0 && file_exists(dirname(substr(\\$tmp, 0, (\\$i + 1))).\"/main.inc.php\")) {",
			"\t\\$res = @include dirname(substr(\\$tmp, 0, (\\$i + 1))).\"/main.inc.php\";",
			"}",
			"// Try main.inc.php using relative path",
			"if (!\\$res && file_exists(\"../../main.inc.php\")) {",
			"\t\\$res = @include \"../../main.inc.php\";",
			"}",
			"if (!\\$res && file_exists(\"../../../main.inc.php\")) {",
			"\t\\$res = @include \"../../../main.inc.php\";",
			"}",
			"if (!\\$res) {",
			"\tdie(\"Include of main fails\");",
			"}",
			"",
			"// Libraries",
			"require_once DOL_DOCUMENT_ROOT.'/core/lib/admin.lib.php';",
			"require_once DOL_DOCUMENT_ROOT.'/core/lib/functions2.lib.php';",
			"require_once '../lib/${1:module_name}.lib.php';",
			"",
			"// Translations",
			"\\$langs->loadLangs(array(\"errors\", \"admin\", \"${1:module_name}@${1:module_name}\"));",
			"",
			"// Access control",
			"if (!\\$user->admin) {",
			"\taccessforbidden();",
			"}",
			"",
			"// Parameters",
			"\\$action = GETPOST('action', 'aZ09');",
			"\\$backtopage = GETPOST('backtopage', 'alpha');",
			"",
			"",
			"/*",
			" * Actions",
			" */",
			"",
			"// None",
			"",
			"",
			"/*",
			" * View",
			" */",
			"",
			"\\$form = new Form(\\$db);",
			"",
			"\\$help_url = '';",
			"\\$page_name = \"${2:ModuleName}\";",
			"",
			"llxHeader('', \\$langs->trans(\\$page_name), \\$help_url);",
			"",
			"// Subheader",
			"\\$linkback = '<a href=\"'.(\\$backtopage ? \\$backtopage : DOL_URL_ROOT.'/admin/modules.php?restore_lastsearch_values=1').'\">'.\\$langs->trans(\"BackToModuleList\").'</a>';",
			"",
			"print load_fiche_titre('${2:ModuleName}', \\$linkback, 'object_${1:module_name}@${1:module_name}');",
			"",
			"// Configuration header",
			"\\$head = ${1:module_name}AdminPrepareHead();",
			"print dol_get_fiche_head(\\$head, '${3:page_name}', \\$langs->trans(\\$page_name), 0, '${1:module_name}@${1:module_name}');",
			"",
			"// For About page",
			"dol_include_once('/${1:module_name}/core/modules/mod${2:ModuleName}.class.php');",
			"\\$tmpmodule = new mod${2:ModuleName}(\\$db);",
			"print \\$tmpmodule->getDescLong();",
			"",
			"// Page end",
			"print dol_get_fiche_end();",
			"llxFooter();",
			"\\$db->close();"
		],
		"description": "Dolibarr - Module setup page"
	},

	"Dolibarr - AJAX request processing": {
		"scope": "php",
		"prefix": "dol:ajax",
		"body": [
			"<?php",
			"",
			"define('NOTOKENRENEWAL', '1');",
			"define('NOREQUIREMENU', '1');",
			"define('NOREQUIREHTML', '1');",
			"define('NOREQUIREAJAX', '1');",
			"define('NOREQUIRESOC', '1');",
			"",
			"// Handling custom/not custom directory",
			"if (file_exists(__DIR__.'/../../main.inc.php')) {",
			"\trequire __DIR__.'/../../main.inc.php';",
			"} else {",
			"\trequire __DIR__.'/../../../main.inc.php';",
			"}",
			"",
			"\\$langs->load('errors');",
			"",
			"try {",
			"\t// Droits",
			"\tif (!\\$user->hasRight('${1:module}', '${2:object}', 'read')) {",
			"\t\tthrow new Exception(\\$langs->trans('ErrorForbidden'));",
			"\t}",
			"",
			"\t\\$id = GETPOSTINT('id');",
			"",
			"\t// Your code ...",
			"\t$0",
			"",
			"\t\\$res = array(",
			"\t\t'status' => 'ok'",
			"\t);",
			"} catch (Exception \\$e) {",
			"\t\\$res = array(",
			"\t\t'status' => 'error',",
			"\t\t'msg' => \\$e->getMessage()",
			"\t);",
			"}",
			"",
			"header('Content-Type: application/json');",
			"echo json_encode(\\$res);",
			"",
			"\\$db->close();"
		],
		"description": "Dolibarr - AJAX endpoint (JSON status ok/error)"
	},

	"Dolibarr - Hook class": {
		"scope": "php",
		"prefix": "dol:hook",
		"body": [
			"<?php",
			"/**",
			" * \\file    class/actions_${1:module}.class.php",
			" * \\ingroup ${1:module}",
			" * \\brief   Hook overload.",
			" *",
			" * Declare in the module descriptor: \\$this->module_parts['hooks'] = array('${2:thirdpartycard}');",
			" */",
			"",
			"/**",
			" * Class Actions${3:Module}",
			" */",
			"class Actions${3:Module}",
			"{",
			"\t/** @var DoliDB */",
			"\tpublic \\$db;",
			"",
			"\tpublic \\$error = '';",
			"\tpublic \\$errors = array();",
			"\tpublic \\$results = array();",
			"\tpublic \\$resprints;",
			"",
			"\t/**",
			"\t * @param DoliDB \\$db Database handler",
			"\t */",
			"\tpublic function __construct(\\$db)",
			"\t{",
			"\t\t\\$this->db = \\$db;",
			"\t}",
			"",
			"\t/**",
			"\t * @param array         \\$parameters Hook metadata (context, etc.)",
			"\t * @param CommonObject  \\$object     Current object",
			"\t * @param string        \\$action     Current action",
			"\t * @param HookManager   \\$hookmanager Hook manager",
			"\t * @return int                      0 = continue, 1 = replace standard code, <0 = error",
			"\t */",
			"\tpublic function ${4:doActions}(\\$parameters, &\\$object, &\\$action, \\$hookmanager)",
			"\t{",
			"\t\tglobal \\$conf, \\$user, \\$langs;",
			"",
			"\t\t\\$error = 0;",
			"",
			"\t\tif (in_array(\\$parameters['currentcontext'], explode(':', '${2:thirdpartycard}'))) {",
			"\t\t\t$0",
			"\t\t}",
			"",
			"\t\tif (!\\$error) {",
			"\t\t\t\\$this->results = array();",
			"\t\t\t\\$this->resprints = '';",
			"\t\t\treturn 0;",
			"\t\t} else {",
			"\t\t\t\\$this->errors[] = 'Error message';",
			"\t\t\treturn -1;",
			"\t\t}",
			"\t}",
			"}"
		],
		"description": "Dolibarr - Hook class (actions_xxx.class.php)"
	},

	// ======== DATABASE & MIGRATIONS ========
	"Dolibarr - SQL select": {
		"scope": "php",
		"prefix": "dol:sql_select",
		"body": [
			"\\$sql = \"SELECT t.rowid, t.${1:field}\";",
			"\\$sql .= \" FROM \".MAIN_DB_PREFIX.\"${2:table} as t\";",
			"\\$sql .= \" WHERE t.entity IN (\".getEntity('${3:element}').\")\";",
			"\\$sql .= \" AND t.${4:fk_field} = \".((int) \\$${5:id});",
			"\\$sql .= \" AND t.${6:str_field} = '\".\\$db->escape(\\$${7:value}).\"'\";",
			"\\$sql .= \\$db->order('t.${8:rowid}', 'ASC');"
		],
		"description": "Dolibarr - Build a SELECT query (entity, int and escaped string conditions)"
	},

	"Dolibarr - SQL Query": {
		"scope": "php,html",
		"prefix": "dol:query",
		"body": [
			"\\$resql = ${1:\\$db}->query(\\$sql);",
			"\\$${2:rows} = array();",
			"if (\\$resql) {",
			"\twhile (\\$${3:row} = ${1:\\$db}->fetch_object(\\$resql)) {",
			"\t\t\\$${2:rows}[] = \\$${3:row};",
			"\t}",
			"\t${1:\\$db}->free(\\$resql);",
			"} else {",
			"\tthrow new RestException(503, 'Error when ${4:...} : '.${1:\\$db}->lasterror());",
			"}"
		],
		"description": "Dolibarr - Execute $sql and fetch rows (REST API context: throws RestException)"
	},

	"Dolibarr - Transaction": {
		"scope": "php",
		"prefix": "dol:transaction",
		"body": [
			"\\$db->begin();",
			"\\$error = 0;",
			"",
			"$0",
			"",
			"if (!\\$error) {",
			"\t\\$db->commit();",
			"} else {",
			"\t\\$db->rollback();",
			"}"
		],
		"description": "Dolibarr - DB transaction with commit/rollback"
	},

	"Dolibarr migration file": {
		"scope": "php",
		"prefix": "dol:migration",
		"body": [
			"<?php",
			"",
			"if (php_sapi_name() !== 'cli') {",
			"\texit('CLI only');",
			"}",
			"",
			"require_once 'htdocs/filefunc.inc.php';",
			"",
			"if (!defined('NOLOGIN')) { define('NOLOGIN', 1); }",
			"if (!defined('NOSESSION')) { define('NOSESSION', 1); }",
			"if (!defined('NOREQUIREMENU')) { define('NOREQUIREMENU', 1); }",
			"require_once DOL_DOCUMENT_ROOT . '/master.inc.php';",
			"require_once DOL_DOCUMENT_ROOT . '/core/lib/admin.lib.php';",
			"require_once DOL_DOCUMENT_ROOT . '/core/class/extrafields.class.php';",
			"",
			"",
			"function up(): void",
			"{",
			"\tglobal \\$db;",
			"\t// Code",
			"\t$0",
			"}",
			"",
			"function down(): void",
			"{",
			"\tglobal \\$db;",
			"\t// Code",
			"}",
			"",
			"",
			"if (\\$argc > 1 && \\$argv[1] == 'down') {",
			"\tdown();",
			"} else {",
			"\tup();",
			"}"
		],
		"description": "Dolibarr - CLI migration file (up/down)"
	},

	"Dolibarr - Extrafield": {
		"scope": "php",
		"prefix": "dol:extrafield",
		"body": [
			"\\$extrafields = new ExtraFields(\\$db);",
			"\\$extrafields->addExtraField(",
			"\t'${1:attrname}',                        // attrname",
			"\t'${2:Label}',                           // label",
			"\t'${3|varchar,int,text,date,boolean|}',  // type",
			"\t${4:100},                               // pos",
			"\t'${5:255}',                             // size",
			"\t'${6:societe}',                         // elementtype",
			"\t0,                                      // unique",
			"\t0,                                      // required",
			"\t'',                                     // default_value",
			"\t'',                                     // param",
			"\t1,                                      // alwayseditable",
			"\t'',                                     // perms",
			"\t'1'                                     // list",
			");",
			"// down(): \\$extrafields->delete('${1:attrname}', '${6:societe}');"
		],
		"description": "Dolibarr - Add an extrafield (use in a migration up()/down())"
	},

	// ======== UI / FRONT ========
	"Dolibarr JQuery Popup": {
		"scope": "php,html",
		"prefix": "dol:popup_jquery",
		"body": [
			"<!-- Ajouter le bouton -->",
			"<a id=\"${1:button_id}\" class=\"butAction\" href=\"#\"><?= \\$langs->trans(\"${6:ButtonLabel}\") ?></a>",
			"",
			"<!-- Ajouter le HTML de la popup (cachée par défaut) -->",
			"<div id=\"${2:popup_id}\" style=\"display: none;\">",
			"\t<form id=\"${3:form_id}\" method=\"post\" action=\"<?= DOL_MAIN_URL_ROOT . '/custom/...' ?>\">",
			"\t\t<input type=\"hidden\" name=\"token\" value=\"<?= newToken() ?>\" />",
			"\t\t<input type=\"hidden\" name=\"action\" value=\"${4:action}\" />",
			"\t\t<input type=\"hidden\" name=\"id\" value=\"<?= \\$object->id ?>\" />",
			"",
			"\t\t<table class=\"border centpercent\">",
			"\t\t</table>",
			"\t</form>",
			"</div>",
			"",
			"<!-- Ajouter le JavaScript pour gérer la popup -->",
			"<script>",
			"\\$(document).ready(function() {",
			"\t// Configuration du dialog jQuery UI",
			"\t\\$(\"#${2:popup_id}\").dialog({",
			"\t\tautoOpen: false,",
			"\t\tmodal: true,",
			"\t\twidth: 600,",
			"\t\ttitle: <?= json_encode(\\$langs->trans('${5:PopupTitle}')) ?>,",
			"\t\tbuttons: [",
			"\t\t\t{",
			"\t\t\t\ttext: <?= json_encode(\\$langs->trans('Confirm')) ?>,",
			"\t\t\t\tclick: function() {",
			"\t\t\t\t\t// Soumettre le formulaire",
			"\t\t\t\t\t\\$(\"#${3:form_id}\").submit();",
			"\t\t\t\t}",
			"\t\t\t},",
			"\t\t\t{",
			"\t\t\t\ttext: <?= json_encode(\\$langs->trans('Cancel')) ?>,",
			"\t\t\t\tclick: function() {",
			"\t\t\t\t\t\\$(this).dialog(\"close\");",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t],",
			"\t\tclose: function() {",
			"\t\t\t// Réinitialiser le formulaire si nécessaire",
			"\t\t\t\\$(\"#${3:form_id}\")[0].reset();",
			"\t\t}",
			"\t});",
			"",
			"\t// Ouvrir la popup au clic sur le bouton",
			"\t\\$(\"#${1:button_id}\").on(\"click\", function(e) {",
			"\t\te.preventDefault();",
			"\t\t\\$(\"#${2:popup_id}\").dialog(\"open\");",
			"\t});",
			"});",
			"</script>"
		],
		"description": "Dolibarr - jQuery UI popup with a POST form"
	},

	"Dolibarr - Native confirm dialog": {
		"scope": "php",
		"prefix": "dol:formconfirm",
		"body": [
			"// Button: <a class=\"butAction\" href=\"<?= \\$_SERVER['PHP_SELF'].'?id='.\\$object->id.'&action=${1:xxx}&token='.newToken() ?>\">...</a>",
			"",
			"// In actions: if (\\$action == 'confirm_${1:xxx}' && GETPOST('confirm', 'alpha') == 'yes') { ... }",
			"",
			"// In view:",
			"if (\\$action == '${1:xxx}') {",
			"\tprint \\$form->formconfirm(",
			"\t\t\\$_SERVER['PHP_SELF'].'?id='.\\$object->id,",
			"\t\t\\$langs->trans('${2:Title}'),",
			"\t\t\\$langs->trans('${3:Question}'),",
			"\t\t'confirm_${1:xxx}',",
			"\t\t'',",
			"\t\t0,",
			"\t\t1",
			"\t);",
			"}"
		],
		"description": "Dolibarr - Native confirmation dialog (Form::formconfirm)"
	},

	"Dolibarr - AJAX call JS": {
		"scope": "php,html,javascript",
		"prefix": "dol:ajax_js",
		"body": [
			"\\$.ajax({",
			"\turl: '<?= dol_buildpath('/${1:module}/ajax/${2:file}.php', 1) ?>',",
			"\tmethod: 'POST',",
			"\tdataType: 'json',",
			"\tdata: {",
			"\t\ttoken: '<?= newToken() ?>',",
			"\t\tid: ${3:id}",
			"\t}",
			"}).done(function (r) {",
			"\tif (r.status === 'ok') {",
			"\t\t$0",
			"\t} else {",
			"\t\t\\$.jnotify(r.msg, 'error', { delay: 2500, fadeSpeed: 500 });",
			"\t}",
			"}).fail(function () {",
			"\t\\$.jnotify('Network error', 'error', { delay: 2500, fadeSpeed: 500 });",
			"});"
		],
		"description": "Dolibarr - jQuery AJAX call matching dol:ajax (PHP inline: needs a .php/.tpl file)"
	},

	"Dolibarr - Toast message JS": {
		"scope": "javascript,typescript,php,html",
		"prefix": "dol:toast_js",
		"body": [
			"\\$.jnotify(${1:r.msg}, '${2|error,warning|}', { delay: ${3:2500}, fadeSpeed: ${4:500} });"
		],
		"description": "Dolibarr - Toast message (JS, jnotify)"
	},

	"Dolibarr - PHP Toast message": {
		"scope": "php,html",
		"prefix": "dol:toast_php",
		"body": [
			"setEventMessages(${1:\\$langs->trans('Key')}, null, '${2|mesgs,warnings,errors|}');"
		],
		"description": "Dolibarr - Toast message (PHP, setEventMessages)"
	},

	// ======== CONFIGURATION ========
	"Dolibarr - Set constant": {
		"scope": "php",
		"prefix": "dol:const_set",
		"body": [
			"\\$result = dolibarr_set_const(\\$db, '${1:MYMODULE_PARAM}', GETPOST('${2:param}', 'alpha'), 'chaine', 0, '', \\$conf->entity);",
			"if (\\$result <= 0) {",
			"\t\\$error++;",
			"\tsetEventMessages(\\$db->lasterror(), null, 'errors');",
			"}"
		],
		"description": "Dolibarr - Save a module constant (needs core/lib/admin.lib.php)"
	}

}
